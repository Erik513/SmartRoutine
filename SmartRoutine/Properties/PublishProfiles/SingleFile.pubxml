<?xml version="1.0" encoding="utf-8"?>
<!-- Publishes SmartRoutine as one self-contained file (the libraries are inside; no installer needed):
       dotnet publish SmartRoutine/SmartRoutine.csproj -p:PublishProfile=SingleFile
     The result is in SmartRoutine\bin\Release\publish\ . -->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>Any CPU</Platform>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <PublishDir>bin\Release\publish\</PublishDir>
  </PropertyGroup>
</Project>
