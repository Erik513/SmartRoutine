<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>SmartRoutine</RootNamespace>
    <AssemblyName>SmartRoutine</AssemblyName>
    <StartupObject>SmartRoutine.Program</StartupObject>
    <ApplicationIcon>Properties\Resources\AppIcon.ico</ApplicationIcon>
    <Version>1.1.0</Version>
    <Product>SmartRoutine</Product>
    <AssemblyTitle>SmartRoutine</AssemblyTitle>
    <Description>Automatisierung wiederkehrender Arbeitsabläufe</Description>
    <Copyright>© 2026 Erik Wink</Copyright>
    <NeutralLanguage>de-DE</NeutralLanguage>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="LiteDB" Version="5.0.21" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3967.48" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="CustomWFUI">
      <HintPath>..\lib\CustomWFUI\CustomWFUI.dll</HintPath>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <!-- CustomWFUI.Forms.AppUpdater needs GitHubSelfUpdater + its polyfills at runtime;
         nothing here references those types directly, so a loose copy is enough for
         most of them - .NET's own unification satisfies a legacy net48 assembly's
         request for an old System.Buffers/System.Memory/etc. from the net8.0 shared
         framework automatically. System.Text.Json is the one exception: GitHubSelfUpdater
         (net48) hard-requires exactly 8.0.0.5, which does NOT get unified against the
         framework's own 8.0.0.0 - it must be a real Reference (not just a copied file)
         so it ends up in SmartRoutine.deps.json, which is what .NET's assembly resolver
         actually consults at runtime. Adding the same explicit-Reference treatment to
         the other polyfills breaks things instead: their vendored copies here are OLDER
         than what LiteDB itself needs, and an explicit Reference makes MSBuild prefer
         that older vendored copy over the correct one for every consumer in the app. -->
    <None Include="..\lib\GitHubSelfUpdater\*.dll" Exclude="..\lib\GitHubSelfUpdater\System.Text.Json.dll" CopyToOutputDirectory="PreserveNewest" Visible="false" />
    <Reference Include="System.Text.Json">
      <HintPath>..\lib\GitHubSelfUpdater\System.Text.Json.dll</HintPath>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <None Include="Properties\Resources\AppIcon.ico" />
    <None Include="Properties\Resources\IconLogo.png" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Properties\Resources.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
    <None Update="Properties\Settings.settings">
      <Generator>SettingsSingleFileGenerator</Generator>
      <LastGenOutput>Settings.Designer.cs</LastGenOutput>
    </None>
  </ItemGroup>

</Project>
