<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>SmartRoutine</RootNamespace>
    <AssemblyName>SmartRoutine</AssemblyName>
    <StartupObject>SmartRoutine.Program</StartupObject>
    <ApplicationIcon>Properties\Resources\AppIcon.ico</ApplicationIcon>
    <Version>1.1.0</Version>
    <Product>SmartRoutine</Product>
    <AssemblyTitle>SmartRoutine</AssemblyTitle>
    <Description>Automatisierung wiederkehrender Arbeitsabläufe</Description>
    <Copyright>© 2026 Erik Wink</Copyright>
    <NeutralLanguage>de-DE</NeutralLanguage>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="LiteDB" Version="5.0.21" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3967.48" />
  </ItemGroup>

  <ItemGroup>
    <!-- CustomWFUI now multi-targets net48;net8.0-windows itself, so this picks up
         its net8.0-windows leg directly - no more vendored DLL, and no more manual
         GitHubSelfUpdater copy either, since CustomWFUI's net8.0-windows build
         already references GitHubSelfUpdater via its own ProjectReference and pulls
         its dependencies (System.Text.Json etc.) through normal NuGet/deps.json
         resolution. -->
    <ProjectReference Include="..\..\CustomWFUI\CustomWFUI\CustomWFUI.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Properties\Resources\AppIcon.ico" />
    <None Include="Properties\Resources\IconLogo.png" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Properties\Resources.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
    <None Update="Properties\Settings.settings">
      <Generator>SettingsSingleFileGenerator</Generator>
      <LastGenOutput>Settings.Designer.cs</LastGenOutput>
    </None>
  </ItemGroup>

</Project>
