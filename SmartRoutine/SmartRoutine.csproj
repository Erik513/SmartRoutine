<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>SmartRoutine</RootNamespace>
    <AssemblyName>SmartRoutine</AssemblyName>
    <StartupObject>SmartRoutine.Program</StartupObject>
    <ApplicationIcon>Properties\Resources\AppIcon.ico</ApplicationIcon>
    <Version>1.1.0</Version>
    <Product>SmartRoutine</Product>
    <AssemblyTitle>SmartRoutine</AssemblyTitle>
    <Description>Automation of recurring workflows</Description>
    <Copyright>© 2026 Erik Wink</Copyright>
    <NeutralLanguage>en-US</NeutralLanguage>
    <!-- The WebView2 package brings WPF assemblies (WindowsBase) of an older target that the .NET 8 reference pack also has;
         the conflict is harmless because the program uses only the WinForms control. -->
    <NoWarn>$(NoWarn);MSB3277</NoWarn>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <!-- The symbols are inside the program (the log of errors then has line numbers); the XML documentation of the
         libraries is not copied next to the exe on publish. -->
    <DebugType>embedded</DebugType>
    <PublishReferencesDocumentationFiles>false</PublishReferencesDocumentationFiles>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="LiteDB" Version="5.0.21" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3967.48" />
  </ItemGroup>

  <ItemGroup>
    <!-- ErikwnkWFUI multi-targets net48;net8.0-windows itself, so this picks up
         its net8.0-windows leg directly - no more vendored DLL, and no more manual
         ErikwnkCore copy either, since ErikwnkWFUI's net8.0-windows build
         already references ErikwnkCore via its own ProjectReference and pulls
         its dependencies (System.Text.Json etc.) through normal NuGet/deps.json
         resolution. -->
    <ProjectReference Include="..\..\ErikwnkWFUI\ErikwnkWFUI\ErikwnkWFUI.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Properties\Resources\AppIcon.ico" />
    <None Include="Properties\Resources\IconLogo.png" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Properties\Resources.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
    <None Update="Properties\Settings.settings">
      <Generator>SettingsSingleFileGenerator</Generator>
      <LastGenOutput>Settings.Designer.cs</LastGenOutput>
    </None>
  </ItemGroup>

</Project>
